POSTGRES_DB=esgwatchdog
POSTGRES_USER=esgwatchdog
POSTGRES_PASSWORD=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer # 클라우드는 require

DART_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=esg-watchdog-dev

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 빈 값 뒤 인라인 주석은 python-dotenv 가 값으로 읽으므로 주석은 윗줄에 둔다
# LLM_PROVIDER: openai | anthropic | fake(오프라인 배관 검증용)
LLM_PROVIDER=
LLM_API_KEY=
# LLM_MODEL_EXTRACT: F-02·F-03 (경량 모델)
LLM_MODEL_EXTRACT=
# LLM_MODEL_JUDGE: F-04·F-06 (상위 모델). 하나로 통일해도 됨
LLM_MODEL_JUDGE=

# DATABASE_URL: app/ 전용 읽기 계정(app_ro). postgresql+psycopg:// 스킴. 파이프라인은 안 씀
DATABASE_URL=
